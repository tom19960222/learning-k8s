#!/usr/bin/env bash
# fake az v1（Task 3）——可程式化的 Azure CLI 替身，供 PATH 覆蓋使用。
# 風格對齊 tests/fakes/ssh，但 az 呼叫是同步、低頻，所以不做 delay/lock。
#
# 協定：
#   FAKE_AZ_SCRIPT  必填。每行一筆期望：`pattern|rc|stdout-file`
#                   - pattern：對「完整 argv 字串」做 grep -F 子字串比對（不得含 `|`）
#                   - rc：離開碼；stdout-file：空 = 無輸出
#                   - 空行與 `#` 開頭忽略
#   FAKE_AZ_LOG     每次呼叫記一行（argv）
#   FAKE_AZ_STATE   狀態目錄（預設 <script>.state）：count / consumed / call.<n>.args
#
# 消費規則同 fake ssh：從「第一筆未消費」往後找第一筆命中者並標記消費，
# 因此同 pattern 連兩筆即「先敗後成」；非預期指令一律 exit 96（不得靜默成功）。
set -u

args="$*"
script="${FAKE_AZ_SCRIPT:-}"
state="${FAKE_AZ_STATE:-${script}.state}"
mkdir -p "$state" 2>/dev/null || true

n=0
[ -f "$state/count" ] && n="$(cat "$state/count")"
n=$((n + 1))
printf '%s\n' "$n" > "$state/count"
printf '%s' "$args" > "$state/call.${n}.args"
if [ -n "${FAKE_AZ_LOG:-}" ]; then
  printf '%s' "$args" | tr '\n\r' '  ' >> "$FAKE_AZ_LOG"
  printf '\n' >> "$FAKE_AZ_LOG"
fi

consumed="$state/consumed"
[ -f "$consumed" ] || : > "$consumed"

lineno=0
matched=0
hit=""
if [ -n "$script" ] && [ -f "$script" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    case "$line" in ''|'#'*) continue ;; esac
    grep -qx -- "$lineno" "$consumed" && continue
    pat="${line%%|*}"
    if printf '%s' "$args" | grep -qF -- "$pat"; then
      matched=1
      hit="${line#*|}"
      printf '%s\n' "$lineno" >> "$consumed"
      break
    fi
  done < "$script"
fi

if [ "$matched" -eq 0 ]; then
  printf 'fake-az: UNEXPECTED call #%s: %s\n' "$n" "$args" >&2
  exit 96
fi

rc="${hit%%|*}"
outfile="${hit#*|}"
if [ -n "$outfile" ] && [ -f "$outfile" ]; then
  cat "$outfile"
fi
exit "${rc:-0}"
